{
 "uid": "llm-triage",
 "title": "Metal3 LLM triage",
 "schemaVersion": 41,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Latency: total and time to first token",
   "type": "bargauge",
   "description": "median = total wall time per failure; ttft_median = time to first token (local models, from Ollama timings).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "metal3_triage_latency_seconds{stat=~\"median|ttft_median\"}",
     "legendFormat": "{{model}} {{stat}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 2,
   "title": "Citation validity",
   "type": "bargauge",
   "description": "Mean share of cited line numbers that exist in the filtered log (verify.py). Below 100% = invented evidence.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "metal3_triage_citation_validity",
     "legendFormat": "{{model}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "unit": "percentunit",
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 3,
   "title": "Accuracy vs hand labels",
   "type": "bargauge",
   "description": "Share of hand-labelled failures (data/labels.csv, labels.py) the model categorised correctly.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "metal3_triage_accuracy",
     "legendFormat": "{{model}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "unit": "percentunit",
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 4,
   "title": "Categories per model",
   "type": "bargauge",
   "description": "How each model labels the failures; a model that puts nearly everything in one category is biased.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sort_desc(metal3_triage_results)",
     "legendFormat": "{{model}} / {{category}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 5,
   "title": "Tokens",
   "type": "bargauge",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 7,
    "w": 6,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "metal3_triage_tokens",
     "legendFormat": "{{model}} {{dir}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 6,
   "title": "Total cost",
   "type": "stat",
   "description": "Local models and the free OpenRouter tier cost $0.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 7,
    "w": 6,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(metal3_triage_cost_usd)",
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "title": "Serve / failover: answers by model",
   "type": "timeseries",
   "description": "Grows while triage.py serve runs. A kill of llm-server shows as llama3 going flat and llama3.2:3b taking over.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 16,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (served_by) (metal3_serve_answers)",
     "legendFormat": "{{served_by}}",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "title": "Fallbacks per run",
   "type": "bargauge",
   "description": "Jobs that could not be served by the server model.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 17,
    "w": 8,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "metal3_serve_fallbacks",
     "legendFormat": "{{run}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  }
 ]
}